generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  USER
  WRITER
  ADMIN
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum FollowKind {
  CATEGORY
  AUTHOR
}

enum MediaKind {
  IMAGE
  AUDIO
  VIDEO
}

model User {
  id           String    @id @default(cuid())
  name         String
  slug         String?   @unique
  email        String    @unique
  passwordHash String
  image        String?
  bio          String?
  dateOfBirth  DateTime?
  location     String?
  website      String?
  phone        String?
  role         Role      @default(USER)
  banned       Boolean   @default(false)
  chatPrefs    Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  articles      Article[]
  bookmarks     Bookmark[]
  attempts      QuizAttempt[]
  history       ReadingHistory[]
  media         Media[]
  chats         ChatThread[]
  comments      Comment[]
  follows       Follow[]
  notifications Notification[]
  resetTokens   PasswordResetToken[]
  subscriber    Subscriber?
  reactions     ArticleReaction[]
  commentLikes  CommentLike[]

  @@index([role])
  @@index([createdAt])
}

model ChatThread {
  id      String  @id @default(cuid())
  title   String
  userId  String?
  guestId String?

  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([guestId, updatedAt])
}

model ChatMessage {
  id       String     @id @default(cuid())
  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  role    String
  content String

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

model Media {
  id       String    @id @default(cuid())
  url      String
  pathname String
  kind     MediaKind
  name     String
  mime     String
  size     Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, kind])
  @@index([createdAt])
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  articles Article[]

  @@index([name])
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  articles ArticleTag[]

  @@index([name])
}

model Article {
  id         String @id @default(cuid())
  title      String
  slug       String @unique
  excerpt    String
  content    Json
  coverImage String

  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  scheduledAt DateTime?

  viewCount Int      @default(0)
  videoUrl  String?
  audioUrl  String?
  keyPoints String[] @default([])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  tags      ArticleTag[]
  quiz      Quiz?
  bookmarks Bookmark[]
  history   ReadingHistory[]
  comments  Comment[]
  reactions ArticleReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([scheduledAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([createdAt])
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Quiz {
  id        String @id @default(cuid())
  articleId String @unique

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  title     String
  questions Json

  attempts QuizAttempt[]

  @@index([articleId])
}

model QuizAttempt {
  id String @id @default(cuid())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  score Int
  total Int

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([quizId])
  @@index([userId, quizId, createdAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
}

model ReadingHistory {
  userId    String
  articleId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@id([userId, articleId])
  @@index([articleId])
  @@index([userId, readAt])
}

model SiteSetting {
  id          Int    @id @default(1)
  siteName    String @default("Lumina")
  tagline     String @default("A calmer place for technology.")
  description String @default("Lumina is a modern publication for people who build, design, and decide.")
}

model Comment {
  id   String @id @default(cuid())
  body String

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  likes CommentLike[]

  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
  @@index([parentId])
  @@index([userId])
  @@index([createdAt])
}

enum ReactionKind {
  LIKE
  DISLIKE
}

model ArticleReaction {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  kind      ReactionKind
  createdAt DateTime     @default(now())
  updateAt  DateTime     @updatedAt

  @@id([userId, articleId])
  @@index([articleId, kind])
  @@index([userId, kind])
}

model CommentLike {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, commentId])
  @@index([commentId])
}

model Follow {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind     FollowKind
  targetId String

  createdAt DateTime @default(now())

  // Prevent duplicate follows by the same user.
  @@id([userId, kind, targetId])
  @@index([kind, targetId])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title  String
  body   String
  href   String
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Subscriber {
  id    String @id @default(cuid())
  email String @unique

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source         String    @default("footer")
  unsubscribedAt DateTime?

  createdAt DateTime @default(now())

  @@index([unsubscribedAt])
}

model PasswordResetToken {
  id        String @id @default(cuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
